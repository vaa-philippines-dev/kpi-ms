// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum KpiPeriod {
  WEEKLY
  MONTHLY
}

// Whether a KpiDefinition's deviationThresholdPct/criticalThresholdPct hold
// percentage-of-target deviation (PERCENT, the historical default), a raw
// value on the same scale as the target itself — a floor for higher-is-
// better, a ceiling for lower-is-better — with clearing that floor/ceiling
// counting as full On Target (VALUE), or literal At-Risk/Critical threshold
// values on the actual's own scale that are compared directly against the
// actual rather than against a %-of-target deviation, with On Target
// requiring the real target itself (DIRECT) — see computeStatus in
// lib/performance.ts for how each is evaluated. Lives on KpiDefinition only:
// a KPI's threshold semantics don't vary per connection, same as direction/
// unit/period.
enum ThresholdUnit {
  PERCENT
  VALUE
  DIRECT
}

enum PerformanceStatus {
  ON_TARGET
  AT_RISK
  CRITICAL
  NO_DATA
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
}

enum UserRole {
  ADMIN
  // Full read visibility everywhere ADMIN has it (every department,
  // connection, report, and admin page) but never a mutation — every
  // create/update/delete action's own role check is a fixed allow-list
  // that simply never names EXECUTIVE, rather than a "not VA" style
  // exclusion, so this role can't fall through into write access by
  // accident. See lib/connection-scope.ts for the read-side scoping.
  EXECUTIVE
  DM
  // Operations Manager — department-wide permissions equivalent to DM
  // (Manager). Distinct from OM below, which despite the short name is the
  // legacy "Team Leader" role (own connections + led-team connections only).
  OPS_MANAGER
  OM
  SERVICE_MANAGER
  // Client-facing CS Specialist from the CMS (its Users tab's "CS
  // Specialist" and "CS Manager" rows — see lib/cms-sync/cs-sync.ts). Scoped
  // to the connections of the clients they're assigned to via
  // CsClientAssignment, not to any department/team. Distinct from
  // SERVICE_MANAGER, which is the CMS's per-department Service Manager.
  CS_SPECIALIST
  // Head of the CS team — sees every CS Specialist's client book (all
  // connections under any CS-assigned client), broken down per specialist,
  // and can resolve any of their status requests. Assigned by hand, not by
  // the CMS sync (the CMS's own "CS Manager" rows mostly carry client books
  // of their own and are imported as CS_SPECIALIST).
  CS_MANAGER
  VA
}

enum ConnectionStatus {
  ACTIVE
  PAUSED
  END_OF_CONTRACT
  END_OF_PROJECT
  PENDING
  // Legacy's 6th status (AppVAConnections.html) — a manual on/off toggle
  // distinct from Paused: reversible back to Active via the same "Set
  // Active" quick action Paused gets, not a terminal state like End of
  // Contract/Project. Previously unmapped in reference-sync.ts, so every
  // Inactive legacy connection silently defaulted to ACTIVE here.
  INACTIVE
}

enum ConnectionType {
  REGULAR
  PROJECT_BASED
}

// A client's status as the KPI system sees it — derived purely from its own
// Connections (ACTIVE when at least one is ACTIVE/PAUSED/PENDING), never
// copied from the CMS's Customers.Status, since KPI connection statuses are
// the source of truth. The raw CMS value is kept alongside in
// Customer.cmsStatus for reference only.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum StatusChangeRequestState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  URGENT
}

enum TicketCategory {
  BUG
  QUESTION
  FEATURE_REQUEST
  DATA_ISSUE
  OTHER
}

model Department {
  id                    String           @id @default(cuid())
  name                  String           @unique
  services              Service[]
  teams                 Team[]
  kpiDefinitions        KpiDefinition[]
  connections           Connection[]
  users                 User[]
  vaMemberships         UserDepartment[]
  // Optional daily submission window ("HH:mm", Asia/Manila) to spread VA
  // submission traffic across the day. Null on either side = unrestricted.
  submissionWindowStart String?
  submissionWindowEnd   String?
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
}

model Service {
  id                       String                 @id @default(cuid())
  name                     String
  department               Department             @relation(fields: [departmentId], references: [id])
  departmentId             String
  isActive                 Boolean                @default(true)
  // Legacy ServiceID — lets the legacy sync upsert idempotently.
  legacyId                 String?                @unique
  kpiDefinitions           KpiDefinition[]
  connections              Connection[]
  users                    User[]
  connectionMemberships    ConnectionService[]
  kpiDefinitionMemberships KpiDefinitionService[]
  vaMemberships            UserService[]
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(3)

  @@index([departmentId])
}

model Team {
  id                String       @id @default(cuid())
  name              String
  department        Department   @relation(fields: [departmentId], references: [id])
  departmentId      String
  teamLeader        User?        @relation("TeamLeader", fields: [teamLeaderId], references: [id])
  teamLeaderId      String?
  tempLeader1       User?        @relation("TeamTempLeader1", fields: [tempLeader1Id], references: [id])
  tempLeader1Id     String?
  tempLeader2       User?        @relation("TeamTempLeader2", fields: [tempLeader2Id], references: [id])
  tempLeader2Id     String?
  isActive          Boolean      @default(true)
  members           User[]       @relation("TeamMembers")
  additionalMembers UserTeam[]
  connections       Connection[]
  // Legacy TeamID — lets the legacy sync upsert idempotently.
  legacyId          String?      @unique
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  @@index([departmentId])
}

model KpiDefinition {
  id                    String                 @id @default(cuid())
  name                  String
  cluster               String
  department            Department             @relation(fields: [departmentId], references: [id])
  departmentId          String
  service               Service?               @relation(fields: [serviceId], references: [id])
  serviceId             String?
  // Extra services this KPI (a cluster's definition) also applies to,
  // beyond the primary `service` above — e.g. "Compliance & Back-Office
  // Output" scoped to both Customer Service Representative VA and
  // Executive Assistant VA, without being department-wide (serviceId
  // null, which still means "every service"). Mirrors Connection's own
  // additionalServices, one level up — see getKpiDefinitionServiceIds in
  // lib/kpi-definition-services.ts, which every KPI-applicability query
  // reads this union from instead of the primary serviceId alone.
  additionalServices    KpiDefinitionService[]
  direction             KpiDirection
  period                KpiPeriod
  targetValue           Float
  // Legacy KPI_Master.Unit — display-only ("%", "number", "hrs", …), never
  // used in calculations. Nullable because it wasn't captured before this
  // field existed; UI should fall back to "—" rather than assuming "%".
  unit                  String?
  // On-Target boundary: |actual-target|/target <= this % (legacy default 10%).
  // When thresholdUnit is VALUE, holds a raw floor/ceiling on the target's
  // own scale instead — see computeStatus in lib/performance.ts.
  deviationThresholdPct Float                  @default(10)
  // At-Risk/Critical boundary: above this %, status is Critical (legacy default 25%).
  // Same VALUE-mode reinterpretation as deviationThresholdPct above.
  criticalThresholdPct  Float                  @default(25)
  // PERCENT (default) or VALUE — see the ThresholdUnit enum doc above.
  thresholdUnit         ThresholdUnit          @default(PERCENT)
  submissionRecords     SubmissionRecord[]
  performanceSummaries  PerformanceSummary[]
  submissionDrafts      SubmissionDraft[]
  kpiConfigs            KpiConfig[]
  // Legacy KPIID — one legacy KPI has both a WeeklyTarget and MonthlyTarget,
  // so it maps to up to two rows here (one per period); unique per period.
  legacyId              String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([legacyId, period])
  @@index([departmentId])
  @@index([serviceId])
}

// Join row for KpiDefinition.additionalServices — see the comment there.
model KpiDefinitionService {
  id              String        @id @default(cuid())
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  kpiDefinitionId String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId       String
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([kpiDefinitionId, serviceId])
  @@index([serviceId])
}

// Originally a stand-in for a live Workforce Management integration —
// Connections are now also populated from the real Customer Management
// System (CMS) via src/lib/cms-sync (see externalCmsId below), alongside
// the older legacy-KPI-sheet sync (externalWfmId).
model Connection {
  id                   String                  @id @default(cuid())
  externalWfmId        String?                 @unique
  // CMS's own ConnectionID (format CONN_xxxxxxxxxxxx) — a separate ID
  // space from externalWfmId (legacy KPI sheet's CON_xxxxxx scheme). Set
  // by src/lib/cms-sync/connection-sync.ts, which only ever creates rows
  // (never updates an existing Connection), so this is purely a dedup key
  // for "have we already imported this CMS row" across re-runs.
  externalCmsId        String?                 @unique
  // VA-facing lookup code for the self-serve /submit flow (format
  // CON_XXXXXX, matching the legacy Apps Script short-ID scheme) — lets a VA
  // paste in a code instead of browsing a dropdown of every connection in
  // their manager's scope, which leaked other VAs' client names.
  shortCode            String                  @unique
  vaUser               User                    @relation("VaConnections", fields: [vaUserId], references: [id])
  vaUserId             String
  clientName           String
  // Legacy SecondaryName — a second display name shown under the client
  // name (e.g. an internal account alias), independent of ClientEmail.
  secondaryName        String?
  department           Department              @relation(fields: [departmentId], references: [id])
  departmentId         String
  service              Service?                @relation(fields: [serviceId], references: [id])
  serviceId            String?
  // Extra services this connection also draws KPI clusters from, beyond the
  // primary `service` above — e.g. a VA tagged Customer Service
  // Representative VA on this connection who also does Executive Assistant
  // VA-scoped work (Compliance, back-office) for the same client. Mirrors
  // UserDepartment's "home + additional" pattern for hybrid VAs, one level
  // down. See getConnectionServiceIds in lib/connection-services.ts, the
  // single place every KPI-applicability query reads this union from.
  additionalServices   ConnectionService[]
  team                 Team?                   @relation(fields: [teamId], references: [id])
  teamId               String?
  // The CMS client this connection belongs to — resolved by
  // lib/cms-sync/cs-sync.ts from VAConnections.CustomerID (via
  // externalCmsId), falling back to a unique client-name match for
  // legacy-only connections. Drives CS Specialist scoping.
  customer             Customer?               @relation(fields: [customerId], references: [id])
  customerId           String?
  statusChangeRequests StatusChangeRequest[]
  status               ConnectionStatus        @default(ACTIVE)
  // Legacy StartDate — the real, user-set business start date. Nullable
  // because it isn't always known (e.g. connections created before this
  // field existed); callers should fall back to createdAt when null, same
  // as legacy's behavior of defaulting it to "now" on creation.
  startDate            DateTime?               @db.Timestamptz(3)
  // The date the connection actually ended (End of Contract/Project),
  // distinct from ConnectionStatusEvent.changedAt for that transition —
  // changedAt is always "when the system was updated," which is often days
  // after the real end date, so this is user-settable/backdatable like
  // startDate above. Null until the connection reaches a terminal status.
  eocDate              DateTime?               @db.Timestamptz(3)
  connectionType       ConnectionType          @default(REGULAR)
  // Legacy IsFlagged — manager-raised attention flag, independent of status.
  isFlagged            Boolean                 @default(false)
  // Legacy saveConnectionNote/getConnectionNote — free-text note, separate
  // from the structured Intervention log.
  notes                String?
  statusEvents         ConnectionStatusEvent[]
  kpiConfigs           KpiConfig[]
  submissions          Submission[]
  performanceSummaries PerformanceSummary[]
  submissionDrafts     SubmissionDraft[]
  interventions        Intervention[]
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)

  @@index([departmentId])
  @@index([vaUserId])
  @@index([teamId])
  @@index([customerId])
}

// Join row for Connection.additionalServices — see the comment there.
model ConnectionService {
  id           String     @id @default(cuid())
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId    String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([connectionId, serviceId])
  @@index([serviceId])
}

model ConnectionStatusEvent {
  id           String           @id @default(cuid())
  connection   Connection       @relation(fields: [connectionId], references: [id])
  connectionId String
  status       ConnectionStatus
  changedBy    User             @relation(fields: [changedById], references: [id])
  changedById  String
  changedAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@index([connectionId])
}

// Per-connection override of a KpiDefinition's targets/thresholds.
model KpiConfig {
  id                    String             @id @default(cuid())
  connection            Connection         @relation(fields: [connectionId], references: [id])
  connectionId          String
  kpiDefinition         KpiDefinition      @relation(fields: [kpiDefinitionId], references: [id])
  kpiDefinitionId       String
  targetValue           Float?
  deviationThresholdPct Float?
  criticalThresholdPct  Float?
  isApplicable          Boolean            @default(true)
  // Free-text admin notes on this override — shown in the KPI Configuration
  // editor, never used in calculations.
  notes                 String?
  version               Int                @default(1)
  history               KpiConfigHistory[]
  updatedBy             User               @relation(fields: [updatedById], references: [id])
  updatedById           String
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([connectionId, kpiDefinitionId])
  @@index([kpiDefinitionId])
}

model KpiConfigHistory {
  id           String    @id @default(cuid())
  kpiConfig    KpiConfig @relation(fields: [kpiConfigId], references: [id])
  kpiConfigId  String
  fieldChanged String
  oldValue     String?
  newValue     String?
  changedBy    User      @relation(fields: [changedById], references: [id])
  changedById  String
  changedAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([kpiConfigId])
}

model Intervention {
  id           String     @id @default(cuid())
  connection   Connection @relation(fields: [connectionId], references: [id])
  connectionId String
  type         String
  description  String
  actionTaken  String?
  outcome      String?
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdById  String
  // Legacy InterventionID — lets the legacy sync upsert idempotently.
  legacyId     String?    @unique
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@index([connectionId])
}

// Unified audit trail — one row per meaningful mutation anywhere in the
// system (KPI edits, submissions, deletions, connection/team/user changes,
// etc.), independent of the narrower per-entity histories that already
// exist (KpiConfigHistory, ConnectionStatusEvent). Written via
// lib/activity-log.ts's logActivity(), never directly.
model ActivityLog {
  id           String         @id @default(cuid())
  action       ActivityAction
  // Model name the change applies to (e.g. "KpiDefinition", "Connection",
  // "Submission") — plain string rather than an enum so new entity types
  // don't need a migration.
  entityType   String
  entityId     String
  // Human-readable name of the affected record, snapshotted at write time
  // so the log still reads sensibly after the record itself changes name or
  // is deleted (e.g. a connection's client name).
  entityLabel  String?
  // One-line human-readable description shown in the activity table.
  summary      String
  // Per-field old/new values for UPDATE actions — [{field, oldValue, newValue}].
  changes      Json?
  actor        User?          @relation(fields: [actorId], references: [id])
  actorId      String?
  // Snapshot of the actor's role at the time of the action, so a later role
  // change (e.g. DM promoted to Admin) doesn't rewrite history.
  actorRole    UserRole?
  // Snapshot of the department the change happened in, for DM/OM-scoped
  // filtering — null when the entity has no department context.
  departmentId String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([departmentId])
  @@index([createdAt])
}

// Generic key/value store — currently only INTERVENTION_TYPES (comma-separated).
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  updatedById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model Submission {
  id           String             @id @default(cuid())
  connection   Connection         @relation(fields: [connectionId], references: [id])
  connectionId String
  period       KpiPeriod
  periodStart  DateTime           @db.Timestamptz(3)
  submittedAt  DateTime           @default(now()) @db.Timestamptz(3)
  rawPayload   Json
  records      SubmissionRecord[]

  @@index([connectionId])
}

model SubmissionRecord {
  id              String        @id @default(cuid())
  submission      Submission    @relation(fields: [submissionId], references: [id])
  submissionId    String
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])
  kpiDefinitionId String
  value           Float?
  noData          Boolean       @default(false)

  @@index([submissionId])
  @@index([kpiDefinitionId])
}

// Autosaved per-KPI value for the "view all clusters" submit flow — lets a
// VA fill in values across several areas in one sitting without losing
// progress if the tab closes before the final Submit. Purely a scratch pad:
// never counted toward a KPI's status, cleared once the real Submission
// that covers it is created.
model SubmissionDraft {
  id              String        @id @default(cuid())
  connection      Connection    @relation(fields: [connectionId], references: [id])
  connectionId    String
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])
  kpiDefinitionId String
  period          KpiPeriod
  periodStart     DateTime      @db.Timestamptz(3)
  value           Float?
  noData          Boolean       @default(false)
  updatedBy       User          @relation(fields: [updatedById], references: [id])
  updatedById     String
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([connectionId, kpiDefinitionId, period, periodStart])
  @@index([connectionId, period, periodStart])
}

// Computed on write from SubmissionRecord — see lib/performance.ts.
model PerformanceSummary {
  id              String            @id @default(cuid())
  connection      Connection        @relation(fields: [connectionId], references: [id])
  connectionId    String
  kpiDefinition   KpiDefinition     @relation(fields: [kpiDefinitionId], references: [id])
  kpiDefinitionId String
  period          KpiPeriod
  periodStart     DateTime          @db.Timestamptz(3)
  actualValue     Float?
  targetValue     Float
  pct             Float?
  status          PerformanceStatus
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([connectionId, kpiDefinitionId, periodStart])
  @@index([kpiDefinitionId])
}

// Anonymous, DB-backed rate-limit counter — no Redis/KV in this stack, so a
// small table stands in. `key` is caller-defined (e.g. "submit-lookup:<ip>",
// "submit:<connectionId>"); checkRateLimit() in lib/rate-limit.ts prunes
// rows past their own window on every check rather than needing a cron job.
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, createdAt])
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String?
  role                   UserRole                @default(SERVICE_MANAGER)
  isActive               Boolean                 @default(true)
  lastLogin              DateTime?               @db.Timestamptz(3)
  loginCount             Int                     @default(0)
  department             Department?             @relation(fields: [departmentId], references: [id])
  departmentId           String?
  service                Service?                @relation(fields: [serviceId], references: [id])
  serviceId              String?
  team                   Team?                   @relation("TeamMembers", fields: [teamId], references: [id])
  teamId                 String?
  ledTeams               Team[]                  @relation("TeamLeader")
  tempLedTeams1          Team[]                  @relation("TeamTempLeader1")
  tempLedTeams2          Team[]                  @relation("TeamTempLeader2")
  vaConnections          Connection[]            @relation("VaConnections")
  statusChanges          ConnectionStatusEvent[]
  kpiConfigsUpdated      KpiConfig[]
  kpiConfigHistory       KpiConfigHistory[]
  interventions          Intervention[]
  settingsUpdated        Setting[]
  activityLogs           ActivityLog[]
  ticketsCreated         Ticket[]                @relation("TicketCreator")
  ticketsClosed          Ticket[]                @relation("TicketCloser")
  ticketMessages         TicketMessage[]         @relation("TicketMessageSender")
  submissionDrafts       SubmissionDraft[]
  // Extra departments a VA also belongs to, on top of `department` above
  // (kept as-is, e.g. a VA who does both Amazon and Executive Assistant
  // work). Managers (DM/OPS_MANAGER/OM) never get rows here — they stay
  // single-department, since their own department drives their own
  // authorization scope, not just a display label like it is for a VA.
  additionalDepartments  UserDepartment[]
  // Extra services a VA also holds, on top of `service` above — one level
  // down from additionalDepartments. No per-department cap: mirrors
  // Connection.additionalServices, which already lets a single connection
  // hold more than one service within its one department (see
  // getConnectionServiceIds in lib/connection-services.ts) — a hybrid VA
  // can do the same across (and within) their departments.
  additionalServices     UserService[]
  // Extra teams a VA also holds, on top of `team` above — same
  // "home + additional" shape as additionalDepartments/additionalServices,
  // but capped at one team per department (see
  // assertTeamsAndServicesInDepartments in dashboard/users/actions.ts),
  // since a team always belongs to exactly one department.
  additionalTeams        UserTeam[]
  // CS_SPECIALIST only — the clients this CS handles (see CsClientAssignment).
  csAssignments          CsClientAssignment[]
  statusRequestsCreated  StatusChangeRequest[]   @relation("StatusRequestCreator")
  statusRequestsResolved StatusChangeRequest[]   @relation("StatusRequestResolver")
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  @@index([departmentId])
  @@index([serviceId])
  @@index([teamId])
}

model Ticket {
  id          String          @id @default(cuid())
  subject     String
  category    TicketCategory  @default(OTHER)
  priority    TicketPriority  @default(NORMAL)
  status      TicketStatus    @default(OPEN)
  createdBy   User            @relation("TicketCreator", fields: [createdById], references: [id])
  createdById String
  closedBy    User?           @relation("TicketCloser", fields: [closedById], references: [id])
  closedById  String?
  closedAt    DateTime?       @db.Timestamptz(3)
  messages    TicketMessage[]
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([createdById])
  @@index([status])
}

model TicketMessage {
  id            String   @id @default(cuid())
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId      String
  sender        User     @relation("TicketMessageSender", fields: [senderId], references: [id])
  senderId      String
  body          String
  // Plain URL, not a file upload — no upload infra exists anywhere in this
  // app; "attach via link" is the user's own spec for this.
  attachmentUrl String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([ticketId, createdAt])
}

// A VA's departments beyond their primary `User.department` — every place
// that scopes VA visibility by department (the Connections "pick a VA"
// dropdown, Users list filtering, Team membership, "View as") treats a VA
// as belonging to `department` UNION whatever's here, with no department
// among them treated as more "real" than another.
model UserDepartment {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([userId, departmentId])
  @@index([departmentId])
}

// A VA's services beyond the primary `User.service` above — mirrors
// UserDepartment's "home + additional" pattern one level down, same
// convention: `service` UNION whatever's here, no service among them
// treated as more "real" than another. Each row here should resolve to one
// of this VA's own departments (home `department` or one of
// `additionalDepartments`) — enforced in
// assertTeamsAndServicesInDepartments, not at the DB level. No cap on how
// many services per department (see User.additionalServices above).
model UserService {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, serviceId])
  @@index([serviceId])
}

// A VA's teams beyond the primary `User.team` above — mirrors UserService's
// "home + additional" pattern, but (unlike UserService) still capped at one
// team per department, enforced in assertTeamsAndServicesInDepartments, not
// at the DB level.
model UserTeam {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, teamId])
  @@index([teamId])
}

// A CMS client (Customers tab, CUST_xxxxxxxxxxxx). Only clients that are
// linked to at least one KPI Connection or have an assigned CS are imported.
model Customer {
  id            String               @id @default(cuid())
  externalCmsId String               @unique
  name          String
  // Raw CMS Customers.Status ("Active", "Terminated", ...) — reference only,
  // see CustomerStatus for why it never drives `status` below.
  cmsStatus     String?
  status        CustomerStatus       @default(INACTIVE)
  connections   Connection[]
  csAssignments CsClientAssignment[]
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
}

// CS Specialist <-> client link. The CMS has no ID for this pairing (it's
// just Customers.AssignedSpecialist, an email), so `code` (CSC_xxxxxxxxxxxx)
// is generated here. A reassignment in the CMS deactivates the old row
// rather than deleting it, so the pairing history stays traceable.
model CsClientAssignment {
  id         String   @id @default(cuid())
  code       String   @unique
  csUser     User     @relation(fields: [csUserId], references: [id], onDelete: Cascade)
  csUserId   String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([csUserId, customerId])
  @@index([customerId])
}

// A manager's request to move a connection to another status, routed to the
// CS Specialist(s) assigned to that connection's client (resolved live via
// Connection.customer, so a CMS reassignment re-routes open requests too).
// Approving applies the change the same way updateConnectionStatus does.
model StatusChangeRequest {
  id              String                   @id @default(cuid())
  connection      Connection               @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId    String
  fromStatus      ConnectionStatus
  requestedStatus ConnectionStatus
  // Real end date for an End of Contract/Project request (becomes eocDate).
  effectiveDate   DateTime?                @db.Timestamptz(3)
  reason          String
  state           StatusChangeRequestState @default(PENDING)
  requestedBy     User                     @relation("StatusRequestCreator", fields: [requestedById], references: [id])
  requestedById   String
  resolvedBy      User?                    @relation("StatusRequestResolver", fields: [resolvedById], references: [id])
  resolvedById    String?
  resolvedAt      DateTime?                @db.Timestamptz(3)
  resolutionNote  String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([connectionId])
  @@index([state, createdAt])
}
